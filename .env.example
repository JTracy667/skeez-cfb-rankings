# CFB Power Rankings — environment configuration
# Copy this file to .env and fill in your own keys.
# Never commit .env to version control.

# College Football Data API key (https://collegefootballdata.com)
CFBD_API_KEY=

# PropLine API key (https://prop-line.com) — primary source for NCAAF betting lines
PROPLINE_API_KEY=

# The Odds API key (https://the-odds-api.com) — backup source for betting lines
THE_ODDS_API_KEY=
